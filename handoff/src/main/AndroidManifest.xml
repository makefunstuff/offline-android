<?xml version="1.0" encoding="utf-8"?>
<!-- The last Inkling Net: hands its saved search settings to Inkling, then can be uninstalled. No network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="Inkling Net (old, uninstall)"
        android:hasCode="true">
        <!-- Answers only Inkling signed with this key; checked on every call (HandoffProvider). -->
        <provider
            android:name=".HandoffProvider"
            android:authorities="com.lfmpixel.lfm.net.handoff"
            android:exported="true" />
    </application>
</manifest>
