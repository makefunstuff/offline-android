<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lfm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <!-- Splash: with an icon background colour set, Android draws the whole icon (sky, bird and sun), so the navy bird
             never sits straight on the dark background. -->
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/icon_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
