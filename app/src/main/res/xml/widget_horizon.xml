<?xml version="1.0" encoding="utf-8"?>
<!-- Lock screen first: keyguard where the phone offers lock-screen widgets, the home screen everywhere. Refreshed every
     30 minutes and whenever Wren is left; the time itself is a live TextClock. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_horizon" android:previewLayout="@layout/widget_horizon"
    android:description="@string/widget_horizon_description"
    android:minWidth="250dp" android:minHeight="110dp" android:targetCellWidth="4" android:targetCellHeight="2"
    android:minResizeWidth="180dp" android:minResizeHeight="110dp" android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000" android:widgetCategory="home_screen|keyguard" />
