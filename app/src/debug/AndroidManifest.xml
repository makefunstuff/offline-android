<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: feed a recorded clip through the same voice path as the mic (emulators have no real mic),
     and a photo, video or document through the same path as the pickers. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".DebugVoiceReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_VOICE" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugSeeReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_SEE" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugSeedReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_SEED" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugBenchReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_BENCH" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugBackendReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_BACKEND" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugTalkReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_TALK" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugEdgeReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_EDGE" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugDecideReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_DECIDE" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugOmniReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_OMNI" /></intent-filter>
        </receiver>
        <receiver android:name=".DebugEmbedReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.lfmpixel.lfm.DEBUG_EMBED" /></intent-filter>
        </receiver>
    </application>
</manifest>
